DirectoryIndex index.php index.html

# Cache Control para arquivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Cache Control Headers
<IfModule mod_headers.c>
    # CSS e JS - Cache de 1 ano
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # HTML - Cache de 1 hora
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    
    # Imagens e fontes - Cache de 1 ano
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# SEO — LPs locais removidas (implementação antiga)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^agencia-marketing-digital-americana/?$ / [R=301,L]
    RewriteRule ^agencia-marketing-digital-limeira/?$ / [R=301,L]
    RewriteRule ^agencia-marketing-digital-piracicaba/?$ / [R=301,L]
</IfModule>

# Sitemap XML (alias)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Blog — categorias e artigos (fallback se /blog/.htaccess não aplicar)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^blog/categoria/([a-z0-9][a-z0-9-]*)/?$ blog/category.php?slug=$1 [L,QSA]
    RewriteCond %{THE_REQUEST} \s/blog/post\.php[\s?] [NC]
    RewriteCond %{QUERY_STRING} (^|&)slug=([a-z0-9][a-z0-9-]*)
    RewriteRule ^blog/post\.php$ /blog/%2/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/blog/category\.php[\s?] [NC]
    RewriteCond %{QUERY_STRING} (^|&)slug=([a-z0-9][a-z0-9-]*)
    RewriteRule ^blog/category\.php$ /blog/categoria/%2/ [R=301,L]
    RewriteRule ^blog/([a-z0-9][a-z0-9-]+)/?$ blog/post.php?slug=$1 [L,QSA]
</IfModule>

